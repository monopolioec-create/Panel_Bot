     private void returnFromPlayer(){saveCurrentResume();releasePlayer(false);if("episode".equals(sectionKind))showHome();else if("section".equals(screen))showSectionUI();else if(!sectionKind.isEmpty())showSectionUI();else showHome();}
 
+    private String selectedCategoryLabel(){
+        if("__all".equals(selectedCategory))return "ALL";
+        if("__fav".equals(selectedCategory))return t("Favoritos","Favorites");
+        if("__recent".equals(selectedCategory))return "live".equals(sectionKind)?t("Canales recientes","Recent channels"):t("Visto recientemente","Recently watched");
+        for(XtreamApi.Category c:sectionCategories)if(c.id.equals(selectedCategory))return c.name;
+        return "ALL";
+    }
+
+    private String categoryName(String id){for(XtreamApi.Category c:sectionCategories)if(c.id.equals(id))return c.name;return "";}
+    private boolean isAdultName(String n){if(n==null)return false;String u=n.toUpperCase(Locale.ROOT);return u.contains("ADULT")||u.contains("ADULTO")||u.contains("XXX")||u.contains("+18")||u.contains("18+")||u.contains("PORNO")||u.contains("EROT")||u.contains("SEX ")||u.startsWith("SEX");}
+    private boolean needsParental(XtreamApi.Item item){return prefs.parentalEnabled()&&!parentalSessionUnlocked.contains(item.categoryId)&&isAdultName(categoryName(item.categoryId));}
