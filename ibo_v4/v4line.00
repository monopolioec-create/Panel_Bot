     private void playLive(XtreamApi.Item item) {
+        if (needsParental(item)) { verifyParental(() -> playLiveUnlocked(item)); return; }
+        playLiveUnlocked(item);
+    }
+
+    private void playLiveUnlocked(XtreamApi.Item item) {
         currentPlaying=item;currentPlayingKind="live";prefs.addRecent("live",item.id);
         String url=XtreamApi.playback(config,item,prefs.liveFormat());
         if("external".equals(prefs.playerMode())){launchExternal(url);return;}
