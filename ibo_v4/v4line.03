+            wireAction(row,()->runWithParentalForCategory(x.id,()->{selectedCategory=x.id;refreshSectionItems();if(categoryList!=null){categoryList.setSelection(p);categoryList.invalidateViews();}}));
+            row.setOnFocusChangeListener((z,h)->{if(!x.id.equals(selectedCategory))z.setBackground(round(h?Color.rgb(13,42,47):(p%2==0?PANEL:PANEL2),h?ACCENT:Color.TRANSPARENT,h?1:0,4));});
             row.setOnLongClickListener(z->{if(x.id.startsWith("__"))return false;Set<String> hidden=prefs.hiddenCategories(sectionKind);hidden.add(x.id);prefs.hiddenCategories(sectionKind,hidden);Toast.makeText(MainActivity.this,t("Categoría oculta","Category hidden"),Toast.LENGTH_SHORT).show();loadSection(sectionKind,"");return true;});
             return row;
         }
