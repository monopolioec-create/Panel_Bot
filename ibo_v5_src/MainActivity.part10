ue);
        v.setPadding(dp(4),dp(2),dp(4),dp(2));
        String remote=config==null?"":config.brandLogoUrl;
        if(remote!=null&&!remote.isEmpty())ImageLoader.load(v,remote,Color.TRANSPARENT);else v.setImageResource(com.monopolio.mediaplayeribo.R.drawable.tv_digital_icon);
        return v;
    }

    private TextView tv(String s,int sp,int color,boolean bold){TextView v=new TextView(this);v.setText(s);v.setTextSize(sp);v.setTextColor(color);v.setGravity(Gravity.CENTER_VERTICAL);if(bold)v.setTypeface(Typeface.DEFAULT_BOLD);return v;}
    private GradientDrawable round(int fill,int stroke,int width,int radius){GradientDrawable g=new GradientDrawable();g.setColor(fill);g.setCornerRadius(dp(radius));if(width>0)g.setStroke(dp(width),stroke);return g;}
    private int dp(int v){return(int)(v*getResources().getDisplayMetrics().density+.5f);}
    private String t(String es,String en){return"en".equals(prefs.language())?en:es;}
    private String msg(Exception e){return e.getMessage()==null?e.getClass().getSimpleName():e.getMessage();}
    private boolean isAdultCategory(String n){String s=n==null?"":n.toLowerCase(Locale.US);return s.contains("adult")||s.contains("xxx")||s.contains("porno")||s.contains("18+")||s.contains("adults");}

    private void updateClock(TextView v){Runnable r=new Runnable(){@Override public void run(){String fmt="12".equals(prefs.timeFormat())?"hh:mm a":"HH:mm";v.setText(new SimpleDateFormat(fmt,Locale.getDefault()).format(new Date()));ui.postDelayed(this,30000);}};r.run();}

    private void saveCurrentResume(){if(player!=null&&currentPlaying!=null&&!"live".equals(currentPlayingKind)){try{prefs.saveResume(currentPlayingKind,currentPlaying.id,player.getCurrentPosition());}catch(Throwable ignored){}}}
    private void releasePlayer(boolean save){if(save)saveCurrentResume();if(player!=null){try{player.release();}catch(Throwable ignored){}player=null;}playerView=null;}

    @Override public void onBackPressed(){
        if("player".equals(screen)){saveCurrentResume();releasePlayer(false);showSectionUI();return;}
        if("episodes".equals(screen)){loadSection("series","");return;}
        if("section".equals(screen)||"settings".equals(screen)){showHome();return;}
        super.onBackPressed();
    }
    @Override protected void onPause(){saveCurrentResume();super.onPause();}
    @Override protected void onDestroy(){releasePlayer(true);io.shutdownNow();super.onDestroy();}

    private static final class CatRow{final String id,name;final int count;CatRow(String id,String name,int count){this.id=id;this.name=name;this.count=count;}}
    private final class CategoryAdapter extends BaseAdapter{
        private final List<CatRow> data;CategoryAdapter(List<CatRow>d){data=d;}@Override public int getCount(){return data.size();}@Override public Object getItem(int p){return data.get(p);}@Override public long getItemId(int p){return p;}
        @Override public View getView(int p,View v,ViewGroup parent){
            LinearLayout row=v instanceof LinearLayout?(LinearLayout)v:new LinearLayout(MainActivity.this);
            row.removeAllViews();row.setGravity(Gravity.CENTER_VERTICAL);row.setPadding(dp(12),0,dp(10),0);
            CatRow x=data.get(p);
            String shown=(prefs.parentalEnabled()&&!x.id.startsWith("__")&&isAdultName(x.name)?"🔒 ":"")+x.name;
            TextView n=tv(shown,14,x.id.equals(selectedCategory)?SELECTED:TEXT,false);row.addView(n,new LinearLayout.LayoutParams(0,dp(42),1));
            TextView c=tv(String.valueOf(x.count),13,x.id.equals(selectedCategory)?SELECTED:MUTED,false);c.setGravity(Gravity.END|Gravity.CENTER_VERTICAL);row.addView(c,new LinearLayout.LayoutParams(dp(54),dp(42)));
            row.setBackground(x.id.equals(selectedCategory)?round(Color.rgb(18,49,53),SELECTED,1,4):round(p%2==0?PANEL:PANEL2,Color.TRANSPARENT,0,4));
            wireAction(row,()->runWithParentalForCategory(x.id,()->{selectedCategory=x.id;refreshSectionItems();if(categoryList!=null){categoryList.setSelection(p);categoryList.invalidateViews();}}));
            row.setOnFocusChangeListener((z,h)->{if(!x.id.equals(selectedCategory))z.setBackground(round(h?Color.rgb(13,42,47):(p%2==0?PANEL:PANEL2),h?ACCENT:Color.TRANSPARENT,h?1:0,4));});
            row.setOnLongClickListener(z->{if(x.id.startsWith("__"))return false;Set<String> hidden=prefs.hiddenCategories(sectionKind);hidden.add(x.id);prefs.hiddenCategories(sectionKind,hidden);Toast.makeText(MainActivity.this,t("Categoría oculta","Category hidden"),Toast.LENGTH_SHORT).show();loadSection(sectionKind,"");return true;});
            return row;
        }
    }

    private int liveRowColor(boolean selected,boolean focused,int p){if(selected)return Color.rgb(13,72,78);if(focused)return Color.rgb(20,64,69);return p%2==0?Color.rgb(24,29,32):Color.rgb(18,23,26);}
    private GradientDrawable liveRowBackground(boolean selected,boolean focused,int p){return round(liveRowColor(selected,focused,p),selected?SELECTED:(focused?ACCENT:Color.TRANSPARENT),selected?2:(focused?1:0),4);}

    private final class LiveAdapter extends BaseAdapter{
        private final List<XtreamApi.Item> data;LiveAdapter(List<XtreamApi.Item>d){data=d;}@Override public int getCount(){return data.size();}@Override public Object getItem(int p){return data.get(p);}@Override public long getItemId(int p){return p;}
        @Override public View getView(int p,View v,ViewGroup parent){
            XtreamApi.Item item=data.get(p);boolean selected=currentPlaying!=null&&currentPlaying.id.equals(item.id);
            LinearLayout row=new LinearLayout(MainActivity.this);row.setGravity(Gravity.CENTER_VERTICAL);row.setPadding(dp(8),dp(5),dp(8),dp(5));row.setBackground(liveRowBackground(selected,false,p));
            TextView no=tv(String.valueOf(p+1),12,selected?SELECTED:MUTED,false);no.setGravity(Gravity.CENTER);row.addView(no,new LinearLayout.LayoutParams(dp(48),dp(42)));
            ImageView im=new ImageView(MainActivity.this);im.setScaleType(ImageView.ScaleType.CENTER_INSIDE);ImageLoader.load(im,item.icon,Color.TRANSPARENT);row.addView(im,new LinearLayout.LayoutParams(dp(38),dp(38)));
            TextView n=tv(item.name,14,selected?SELECTED:(prefs.isFavorite("live",item.id)?SELECTED:TEXT),selected);n.setPadding(dp(8),0,0,0);row.addView(n,new LinearLayout.LayoutParams(0,dp(44),1));
            wireAction(row,()->playLive(item));
            row.setOnLongClickListener(z->{toggleFavorite(item);return true;});
            row.setOnFocusChangeListener((