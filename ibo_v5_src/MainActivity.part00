public class MainActivity extends Activity {
    private final ExecutorService io = Executors.newFixedThreadPool(3);
    private final Handler ui = new Handler(Looper.getMainLooper());

    private FrameLayout root;
    private DeviceIdentity identity;
    private PanelApi.Config config;
    private String token = "";
    private AppPrefs prefs;

    private ExoPlayer player;
    private PlayerView playerView;
    private XtreamApi.Item currentPlaying;
    private String currentPlayingKind = "";
    private long resumeSeek = 0L;

    private String screen = "activation";
    private String sectionKind = ""; // live | movie | series | episode
    private List<XtreamApi.Category> sectionCategories = new ArrayList<>();
    private List<XtreamApi.Item> sectionAll = new ArrayList<>();
    private List<XtreamApi.Item> sectionFiltered = new ArrayList<>();
    private String selectedCategory = "__all";
    private String sectionSearch = "";
    private String preferredCategoryName = "";

    private ListView categoryList;
    private ListView liveList;
    private GridView mediaGrid;
    private TextView sectionCount;
    private TextView footer;
    private FrameLayout livePreview;
    private TextView liveTitle;
    private TextView liveMeta;
    private EditText searchBox;
    private int heroGeneration = 0;
    private final Set<String> parentalSessionUnlocked = new HashSet<>();
    private final Map<String,List<XtreamApi.Category>> catalogCategories = new ConcurrentHashMap<>();
    private final Map<String,List<XtreamApi.Item>> catalogItems = new ConcurrentHashMap<>();
    private volatile boolean catalogPreloaded = false;
    private int liveHealthGeneration = 0;

    private int BG, PANEL, PANEL2, ACCENT, SELECTED, TEXT, MUTED, BORDER;

    @Override public void onCreate(Bundle b) {
        super.onCreate(b);
        getWindow().setFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN, WindowManager.LayoutParams.FLAG_FULLSCREEN);
        getWindow().getDecorView().setSystemUiVisibility(View.SYSTEM_UI_FLAG_FULLSCREEN | View.SYSTEM_UI_FLAG_HIDE_NAVIGATION | View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY);
        prefs = new AppPrefs(this);
        applyThemeColors();
        root = new FrameLayout(this);
        root.setBackgroundColor(BG);
        setContentView(root);
        identity = DeviceIdentity.read(this);
        token = getPreferences(MODE_PRIVATE).getString("device_token", "");
        showActivation(t("Conectando con el panel…", "Connecting to panel…"));
        bootstrap();
    }

    private void applyThemeColors() {
        BG = Color.rgb(4, 8, 11);
        PANEL = Color.rgb(13, 25, 29);
        PANEL2 = Color.rgb(18, 31, 36);
        TEXT = Color.rgb(242, 246, 247);
        MUTED = Color.rgb(169, 184, 190);
        BORDER = Color.rgb(48, 76, 82);
        String th = prefs == null ? "teal" : prefs.theme();
        if ("gold".equals(th)) { ACCENT = Color.rgb(214, 171, 47); SELECTED = Color.rgb(255, 215, 65); }
        else if ("blue".equals(th)) { ACCENT = Color.rgb(41, 137, 219); SELECTED = Color.rgb(85, 176, 255); }
        else { ACCENT = Color.rgb(0, 191, 200); SELECTED = Color.rgb(239, 211, 35); }
    }

    private void bootstrap() {
        io.execute(() -> {
            try {
                if (token.isEmpty()) {
                    token = PanelApi.register(identity);
                    getPreferences(MODE_PRIVATE).edit().putString("device_token", token).apply();
                }
                checkPanel();
            } catch (Exception e) {
                showActivation(t("Sin conexión al panel. Reintentando…", "No panel connection. Retrying…") + "\n" + msg(e));
                ui.postDelayed(this::bootstrap, 7000);
            }
        });
    }

    private void checkPanel() {
        try {
            PanelApi.Config next = PanelApi.config(identity, token);
            config = next;
            if ("active".equals(next.status) && !next.server.isEmpty() && !next.username.isEmpty() && !next.password.isEmpty()) {
                preloadCatalogAndShowHome();
            } else if ("blocked".equals(next.status)) {
                showActivation(t("DISPOSITIVO BLOQUEADO\nContacta al administrador.", "DEVICE BLOCKED\nContact th