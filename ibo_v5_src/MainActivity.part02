        screen = "section";
        releasePlayer(false);
        root.removeAllViews();
        root.setBackgroundColor(BG);

        LinearLayout all = new LinearLayout(this);
        all.setOrientation(LinearLayout.VERTICAL);

        all.addView(topNav(), new LinearLa